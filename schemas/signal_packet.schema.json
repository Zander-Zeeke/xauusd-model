{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://xauusd.local/schemas/signal_packet.schema.json",
  "title": "SignalPacket",
  "description": "Cross-surface contract for desktop research and Compose/Kivy mobile edge.",
  "type": "object",
  "required": ["timestamp", "direction", "confidence", "spot_usd", "health_status"],
  "additionalProperties": true,
  "properties": {
    "timestamp": { "type": "string", "format": "date-time" },
    "spot_usd": { "type": "number" },
    "spot_as_of": { "type": "string" },
    "spot_symbol": { "type": "string" },
    "spot_source": { "type": "string" },
    "direction": {
      "type": "string",
      "enum": ["bullish", "bearish", "neutral"]
    },
    "score": { "type": "number" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "confidence_raw_agreement": { "type": "number" },
    "confidence_floor": { "type": "number" },
    "confidence_calibrated": { "type": "number" },
    "confidence_model_tp1": { "type": ["number", "null"] },
    "confidence_model_tp2": { "type": ["number", "null"] },
    "confidence_model_tp3": { "type": ["number", "null"] },
    "model_status": { "type": ["string", "null"] },
    "expected_move_band_usd": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2
    },
    "expected_price_band_usd": {
      "type": "array",
      "items": { "type": "number" }
    },
    "ladder": {
      "type": ["object", "null"],
      "additionalProperties": { "type": "number" }
    },
    "factor_attribution": {
      "type": "array",
      "items": { "type": "object" }
    },
    "realized_vol_15m_pct": { "type": ["number", "null"] },
    "intraday_momentum_score": { "type": ["number", "null"] },
    "health_status": { "type": "string" },
    "backtest_hit_rate": { "type": "number" },
    "recent_hit_rate": { "type": ["number", "null"] },
    "recent_outcomes": {
      "type": "array",
      "items": { "type": "object" }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "model_version": { "type": ["string", "null"] },
    "model_sync_status": { "type": ["string", "null"] },
    "model_sync_message": { "type": ["string", "null"] },
    "elite_active": { "type": "boolean" },
    "elite_direction": { "type": "integer" },
    "elite_confidence": { "type": "number" },
    "elite_label": { "type": "string" },
    "elite_reasons_pass": { "type": "array", "items": { "type": "string" } },
    "elite_reasons_fail": { "type": "array", "items": { "type": "string" } },
    "elite_score": { "type": "number" },
    "elite_trigger": { "type": "string" },
    "elite_trigger_label": { "type": "string" },
    "elite_trigger_detail": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "intermarket": { "type": ["object", "null"] },
    "news_pulse": { "type": ["object", "null"] },
    "calendar_guard": { "type": ["object", "null"] },
    "regime": { "type": ["object", "null"] },
    "mtf_cascade": { "type": ["object", "null"] },
    "ml_features": {
      "type": ["object", "null"],
      "additionalProperties": { "type": "number" }
    },
    "research_context": { "type": ["object", "null"] },
    "brain_integrity_warning": { "type": ["string", "null"] },
    "schema_version": { "type": "string", "const": "1.0.0" }
  }
}
